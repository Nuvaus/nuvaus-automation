{
  "mcpServers": {
    "jarvis-memoria": {
      "type": "http",
      "url": "https://memoria.nuvaus.com/mcp",
      "headers": {
        "Authorization": "Bearer ${JARVIS_MEMORY_MCP_TOKEN}"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    }
  }
}
